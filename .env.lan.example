# Локальная сеть: LM Studio на другом ПК (или том же, но через LAN IP).
# Скопируйте в .env и подставьте IP машины с LM Studio.
#
# На машине с LM Studio:
#   1) загрузите модель
#   2) Developer → Local Server → Start Server
#   3) включите Serve on Local Network / слушайте 0.0.0.0:1234
#   4) узнайте IP: macOS `ipconfig getifaddr en0`, Windows `ipconfig`
#
# Проверка с машины, где крутится analizator:
#   curl http://192.168.1.50:1234/v1/models

LM_STUDIO_BASE_URL=http://192.168.1.50:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=local-model
LM_STUDIO_TIMEOUT=5m
LM_TEMPERATURE=0.2
LM_MAX_TOKENS=2048

HTTP_ADDR=:8088
TENDERS_ROOT=./data/tenders
CHECKLISTS_DIR=configs/checklists
PROMPTS_DIR=configs/prompts
DEFAULT_CHECKLIST=default
CHUNK_SIZE=3500
CHUNK_OVERLAP=250
MAX_CHUNKS=40
CONCURRENCY=1

# PostgreSQL опционально — оставьте пустым, если БД не нужна
# DATABASE_URL=postgres://zakupki:zakupki@127.0.0.1:5432/zakupki?sslmode=disable
