FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata curl
WORKDIR /app
COPY bin/analizator /app/analizator
COPY configs /app/configs
# Platform Docker (bridge): host.docker.internal → LM Studio на машине хоста :1234.
# Локальный go run без Docker: задайте LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1 в .env.
ENV HTTP_ADDR=:8088 \
    TENDERS_ROOT=/data/tenders \
    CHECKLISTS_DIR=/app/configs/checklists \
    PROMPTS_DIR=/app/configs/prompts \
    LM_STUDIO_ENDPOINTS_FILE=/app/configs/lm_studio.yaml \
    LM_STUDIO_BASE_URL=http://host.docker.internal:1234/v1 \
    LM_STUDIO_MODEL=local-model \
    LM_STUDIO_API_KEY=lm-studio
EXPOSE 8088
VOLUME ["/data/tenders"]
HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=10 \
  CMD curl -fsS http://127.0.0.1:8088/health || exit 1
ENTRYPOINT ["/app/analizator"]
