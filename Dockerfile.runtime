FROM alpine:3.20
RUN apk add --no-cache ca-certificates tzdata curl
WORKDIR /app
COPY bin/analizator /app/analizator
COPY configs /app/configs
ENV HTTP_ADDR=:8088 \
    TENDERS_ROOT=/data/tenders \
    CHECKLISTS_DIR=/app/configs/checklists \
    PROMPTS_DIR=/app/configs/prompts \
    LM_STUDIO_ENDPOINTS_FILE=/app/configs/lm_studio.yaml
EXPOSE 8088
VOLUME ["/data/tenders"]
HEALTHCHECK --interval=10s --timeout=5s --retries=10 CMD curl -fsS http://127.0.0.1:8088/health || exit 1
ENTRYPOINT ["/app/analizator"]
