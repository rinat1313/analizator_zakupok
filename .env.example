# Скопируйте в .env и поправьте LM_STUDIO_MODEL (id из LM Studio).
#
# Для Docker на том же ПК scripts/up.sh сам подставит
# http://host.docker.internal:1234/v1 вместо 127.0.0.1.
# Для LM Studio на другом ПК в LAN — используйте .env.lan.example.

LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=local-model

HTTP_ADDR=:8088
TENDERS_ROOT=./data/tenders
CHECKLISTS_DIR=configs/checklists
PROMPTS_DIR=configs/prompts
DEFAULT_CHECKLIST=default
CHUNK_SIZE=3500
CHUNK_OVERLAP=250
MAX_CHUNKS=40
CONCURRENCY=2

# В docker compose DATABASE_URL задаётся на сервис postgres автоматически.
# Для локального go run с БД на localhost:
# DATABASE_URL=postgres://zakupki:zakupki@127.0.0.1:5432/zakupki?sslmode=disable
