# LM Studio на ЭТОМ же Mac/ПК при запуске: go run ./cmd/analizator
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
LM_STUDIO_MODEL=local-model
# В Docker / zakupki-platform образ сам ставит host.docker.internal:1234/v1.

HTTP_ADDR=:8088
TENDERS_ROOT=./data/tenders
CHECKLISTS_DIR=configs/checklists
PROMPTS_DIR=configs/prompts
DEFAULT_CHECKLIST=default
CHUNK_SIZE=3500
CHUNK_OVERLAP=250
MAX_CHUNKS=40
# Один процесс на LLM (параллель отключена).
CONCURRENCY=1
